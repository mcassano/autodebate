# Copy to .env and fill in your keys. .env is gitignored — never commit real keys.

# Required with the default lineup (personas + moderator run through OpenRouter):
OPEN_ROUTER_API_KEY=sk-or-...

# Required always (the brave_search tool):
BRAVE_SEARCH_API_KEY=BSA...

# Optional — only needed if you point a persona at a direct provider in config.py:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional — ollama: specs default to http://localhost:11434/v1, override here:
# OLLAMA_BASE_URL=http://my-server:11434/v1

# Optional — web mode only: an opening message so a public café isn't silent:
# AUTODEBATE_TOPIC=What will matter most in 2050 that nobody is preparing for?
